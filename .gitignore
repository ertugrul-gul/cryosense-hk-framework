# NEVER PUBLISHED -----------------------------------------------------------
# The repository root is the project root, so the manuscript and the working
# notes now sit beside the publishable code. These entries come first and are
# deliberately coarse: a draft must never reach GitHub or Zenodo through a
# careless `git add -A`.
/manuscript/
/plan/
/sources/
/submission/
/PROTOKOL.md
/resume.md
/FAZ_C_kurgu.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.matplotlib_cache/

# OS
.DS_Store

# Claude Code / local session artifacts (never publish to GitHub/Zenodo)
.claude/

# Backups (local only, not part of the code archive)
*.bak

# Large raw data and reanalysis archives (obtain from public providers; see data/README.md)
data/*.csv
data/*.nc
data/nc_cilo_sat/
data/spatial/*.tif

# Generated outputs (regenerated by the notebook)
outputs/models/*

# Keep these tracked
!data/README.md
!outputs/tables/
# Processed model-input tables (openly archived for data availability; derived from public sources)
!data/hakkari_gunluk_tum_degiskenler.csv
!data/hakkari_glacier_area_2000_2024_gee_executed.csv
!data/hakkari_spei_sonuclari.csv

# Multi-cell extraction cache (regenerated by the notebook from the public ERA5-Land archive)
data/derived/

# Figures are not archived: the notebook regenerates figures/raw from the
# bundled input table and copies figures/submission out of it.
/figures/

# Journal template, supplied by the publisher and not ours to redistribute.
/water-template.dot
